# PrimeMLS RESO Web API (NH single-family feed). Set these as repo Actions secrets.
PRIMEMLS_CLIENT_ID=your_loginname_here
PRIMEMLS_CLIENT_SECRET=your_password_here

# US Dept of Labor Open Data Portal (apiprod.dol.gov/v4). Local: Windows user env var
# DOL_API_KEY (no .env needed). CI: repo Actions secret DOL_API_KEY.
# DOL takes the key ONLY as the ?X-API-KEY= query param, so redact request URLs in logs.
# Client: E:\tools\dol_api.py (retries 429/502; copy into the repo for CI use).
DOL_API_KEY=your_key_here
